# ---------------------------------------------------------------------------
# Application (Next.js)
# ---------------------------------------------------------------------------
# DATABASE_URL: Neon POOLED connection string (uses "-pooler" in hostname).
# Used by the running Next.js application for runtime queries to prevent connection exhaustion.
# Neon dashboard: Project Dashboard -> Connection Details -> enable "Pooled connection" checkbox/toggle.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Neon UNPOOLED direct connection string (no "-pooler" in hostname).
# Required by Prisma migrations (`prisma migrate deploy`), which cannot run through PgBouncer connection pooling.
# Neon dashboard: Project Dashboard -> Connection Details -> disable "Pooled connection" checkbox/toggle.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="your-32-byte-base64-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Production: your public https URL (e.g. https://tests.example.com). On Vercel,
# AUTH_TRUST_HOST="true" and AUTH_URL = the production domain.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Runner service
# ---------------------------------------------------------------------------
# Production: must be https:// unless the runner is on a private network with the app
# (on Vercel it never is). Secrets must be 32+ characters in production.
# Optional runner pool: comma-separated list of runner base URLs. When set, overrides RUNNER_URL.
# RUNNER_URLS="https://runner-1.example.com,https://runner-2.example.com"
RUNNER_URL="http://localhost:4000"
RUNNER_SECRET="your-32-byte-hex-secret-for-runner-authentication"
RUNNER_TIMEOUT_MS=30000
# Per-test allowance added to the wait above; keep equal to the runner's TEST_TIMEOUT_MS.
RUNNER_TEST_TIMEOUT_MS=6000

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# Required in production on serverless (Vercel) to share sliding-window rate
# limits across ephemeral lambda invocations. In local development, if unset,
# the app fails open with a warning so you can develop offline.
#
# Obtain from Upstash Console (https://console.upstash.com):
# Create a Redis database -> Details page -> scroll down to "REST API" section ->
# select the ".env" tab to copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
UPSTASH_REDIS_REST_URL="https://example-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
# Set to "true" in emergency or staging to disable rate limiting if Redis is down (logs loudly)
ALLOW_NO_RATE_LIMIT="false"

# ---------------------------------------------------------------------------
# Limits and tuning
# ---------------------------------------------------------------------------
MAX_CODE_BYTES=200000
RUN_RATE_LIMIT_PER_MIN=12
SUBMIT_RATE_LIMIT_PER_MIN=6
PROCTOR_RATE_LIMIT_PER_MIN=120
IMAGE_PROXY_RATE_LIMIT_PER_MIN=30
HEARTBEAT_INTERVAL_SECONDS=12
SESSION_STALE_SECONDS=45
TEST_LOG_RETENTION_DAYS=90
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Scheduled maintenance (Vercel Cron -> /api/cron/maintenance; see vercel.json)
# ---------------------------------------------------------------------------
# Grades abandoned sittings, retries stalled grading, applies log retention.
# Unset = the endpoint is disabled. Generate with: openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Seeding (development only)
# ---------------------------------------------------------------------------
# Comma-separated list of admin email addresses used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
# Optional comma-separated list of student email addresses for seeding
SEED_STUDENT_EMAILS=""
SEED_BATCH="2029"
