# ---------------------------------------------------------------------------
# Application (Next.js)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/proctored_db?schema=public"

AUTH_SECRET="your-32-byte-base64-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Runner service
# ---------------------------------------------------------------------------
RUNNER_URL="http://localhost:4000"
RUNNER_SECRET="your-32-byte-hex-secret-for-runner-authentication"
RUNNER_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Limits and tuning
# ---------------------------------------------------------------------------
MAX_CODE_BYTES=200000
RUN_RATE_LIMIT_PER_MIN=12
SUBMIT_RATE_LIMIT_PER_MIN=6
PROCTOR_RATE_LIMIT_PER_MIN=120
HEARTBEAT_INTERVAL_SECONDS=12
SESSION_STALE_SECONDS=45
TEST_LOG_RETENTION_DAYS=90
LOG_LEVEL="info"
