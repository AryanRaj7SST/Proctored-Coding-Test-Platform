{
  "name": "proctored-coding-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated Playwright test runner for untrusted student web code.",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "sandbox": "node dist/sandbox-entry.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/register.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "1.55.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
