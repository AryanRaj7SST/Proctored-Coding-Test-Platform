PORT="4000"
# MUST match RUNNER_SECRET in the application environment.
RUNNER_SECRET="replace-me-with-a-long-random-runner-secret"

# container   = one hardened, disposable BrowserContext per run inside this
#               already-isolated runner container (default, no docker socket).
# docker      = spawn one throwaway `docker run --network=none` container per
#               run (needs a docker socket; see docs/security.md before using).
RUNNER_ISOLATION="container"

RUNNER_MAX_CONCURRENCY="4"     # simultaneous browser contexts
RUNNER_MAX_QUEUE="64"          # queued runs before 429
RUN_TIMEOUT_MS="20000"         # hard wall-clock limit for one run
TEST_TIMEOUT_MS="6000"         # hard limit for a single test case
MAX_PAYLOAD_BYTES="1000000"    # request body ceiling
DOCKER_IMAGE="proctored-runner-sandbox:latest"
DOCKER_MEMORY="256m"
DOCKER_CPUS="0.5"
DOCKER_PIDS_LIMIT="128"
LOG_LEVEL="info"
