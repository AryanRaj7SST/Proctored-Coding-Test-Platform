// Proctored Coding Platform -- data model
// Design notes:
//  * Terminology: Exam = a test/assessment; ExamSession = one attempt at a test
//    (a "sitting", numbered per student); Attempt = the student's work on one
//    question within a sitting.
//  * Versioning: publishing a test pins each question's snapshot on
//    ExamQuestion.snapshot; every Attempt copies that pinned snapshot, so
//    editing a question later never changes what an existing test grades.
//  * Grading: a question's marks are split equally between its enabled test
//    cases (marks x passed / enabled), computed server-side only.
//  * Marks and scores are fixed-point decimals (see src/server/grading).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum QuestionType {
  WEB
  PROGRAMMING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestType {
  DECLARATIVE // JSON behaviour spec interpreted by the runner
}

/// Stored lifecycle only; UPCOMING / ACTIVE / ENDED are derived from the schedule (lib/timing testPhase).
enum ExamStatus {
  DRAFT
  PUBLISHED
  ENDED
  ARCHIVED
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  SUBMITTED
  EXPIRED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum TestRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

enum TestRunKind {
  PRACTICE // student pressed "Run Test Cases"
  SUBMISSION // graded run triggered by submit / auto-submit
  VALIDATION // admin validating a question against its reference solution
}

enum ProctorEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  FULLSCREEN_ENTER
  COPY
  CUT
  PASTE
  CONTEXT_MENU
  PAGE_UNLOAD
  PAGE_RELOAD
  HEARTBEAT_LOST
  EXAM_STARTED
  EXAM_SUBMITTED
  // Camera facts only: the video itself is never stored or uploaded.
  CAMERA_PERMISSION_GRANTED
  CAMERA_PERMISSION_DENIED
  CAMERA_UNAVAILABLE
  CAMERA_STREAM_STOPPED
  CAMERA_RESTORED
}

enum SessionStatus {
  ACTIVE
  AWAY
  DISCONNECTED
  SUBMITTED
  EXPIRED
}

enum ValidationStatus {
  NOT_VALIDATED
  PASSED
  FAILED
}

enum QuestionStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum ExamAccessMode {
  ASSIGNED_USERS_ONLY
  ANY_AUTHENTICATED_USER
}

/// What a student may see once their sitting is finished and graded.
enum ResultVisibility {
  HIDDEN // nothing until an admin changes the setting
  SCORE_ONLY // total score, percentage and pass/fail
  FULL // plus per-question and per-test-case results
}

enum LeaderboardMode {
  LIVE
  AFTER_END
  HIDDEN
}

enum AttemptFlagKind {
  PLAGIARISM
  MANUAL_REVIEW
  DISQUALIFIED
}

/// Outcome of grading one question attempt.
enum QuestionResultStatus {
  NOT_RUN // not graded yet
  PASSED // every enabled test case passed
  PARTIAL // some, not all, passed
  FAILED // none passed
  RUNNER_ERROR // grading infrastructure failed: grading pending, never a score
}

/// Pass/fail of a whole sitting against Exam.passingPercentage.
enum SittingResult {
  PASSED
  FAILED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name          String?
  displayHandle String?   @unique
  image         String?
  role          Role      @default(STUDENT)
  batch         String?
  active        Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attempts            Attempt[]
  assignments         ExamAssignment[]
  proctorEvents       ProctorEvent[]
  sessions            ExamSession[]
  auditLogs           AuditLog[]
  attemptFlagsCreated AttemptFlag[]    @relation("AdminAttemptFlags")

  @@index([role])
  @@index([batch])
  @@map("users")
}

/// Student roster: addresses pre-registered with a batch so tests can be
/// assigned before a first sign-in. NOT an access list -- any Google-verified
/// address may sign in, and roles/account state live on User.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique // always stored lowercase + trimmed
  batch     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batch])
  @@map("allowed_emails")
}

model Question {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  description       String           @db.Text // markdown-lite, rendered safely
  instructions      String?          @db.Text
  type              QuestionType     @default(WEB)
  language          String? // reserved for PROGRAMMING questions
  starterHtml       String           @default("") @db.Text
  starterCss        String           @default("") @db.Text
  starterJs         String           @default("") @db.Text
  // Optional reference solution used by "Validate Question".
  referenceHtml     String?          @db.Text
  referenceCss      String?          @db.Text
  referenceJs       String?          @db.Text
  mediaUrl          String? // illustrative image/video shown in the question panel
  marks             Decimal          @default(10) @db.Decimal(8, 2) // split equally between enabled test cases
  category          String?
  constraints       String?          @db.Text
  expectedBehavior  String?          @db.Text
  suggestedMinutes  Int? // informational; the test duration is authoritative
  difficulty        Difficulty       @default(EASY)
  tags              String[]         @default([])
  status            QuestionStatus   @default(DRAFT)
  publishedAt       DateTime?
  version           Int              @default(1) // bumped whenever content or tests change
  validation        ValidationStatus @default(NOT_VALIDATED)
  validatedAt       DateTime?
  validationMessage String?          @db.Text
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tests          QuestionTest[]
  examQuestions  ExamQuestion[]
  attempts       Attempt[]
  scoreHistories AttemptScoreHistory[]

  @@index([type])
  @@index([status])
  @@index([category])
  @@map("questions")
}

model QuestionTest {
  id               String   @id @default(cuid())
  questionId       String
  name             String
  description      String?  @db.Text // shown to students only when hidden = false
  testType         TestType @default(DECLARATIVE)
  testCode         String   @db.Text // JSON spec or Playwright source -- SERVER ONLY
  expectedBehavior String?  @db.Text
  order            Int      @default(0)
  enabled          Boolean  @default(true) // disabled tests are neither run nor counted
  hidden           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  results  TestResult[]

  @@unique([questionId, name])
  @@index([questionId, order])
  @@map("question_tests")
}

model Exam {
  id                String           @id @default(cuid())
  title             String
  description       String?          @db.Text
  durationMinutes   Int              @default(60)
  startTime         DateTime?
  endTime           DateTime?
  status            ExamStatus       @default(DRAFT)
  active            Boolean          @default(true)
  batch             String?
  maxViolations     Int              @default(0) // 0 = never auto-submit on violations
  shuffleQuestions  Boolean          @default(false)
  countClipboardViolations Boolean       @default(false)
  instructions      String?          @db.Text
  accessMode        ExamAccessMode   @default(ANY_AUTHENTICATED_USER)
  maxAttempts       Int              @default(1)
  passingPercentage Decimal          @default(40) @db.Decimal(5, 2)
  timezone                String           @default("Asia/Kolkata") // IANA zone the admin schedules in; instants are UTC
  resultVisibility        ResultVisibility @default(FULL)
  leaderboardMode         LeaderboardMode  @default(AFTER_END)
  wrongTryPenaltySeconds  Int              @default(300)
  leaderboardFrozenAt     DateTime?
  mandatory               Boolean          @default(true)
  notesMd                 String?          @db.Text
  instructorInfoMd        String?          @db.Text
  publishedAt             DateTime?
  resultsPublishedAt      DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  questions   ExamQuestion[]
  assignments ExamAssignment[]
  attempts    Attempt[]
  sessions    ExamSession[]
  events      ProctorEvent[]

  @@index([status])
  @@index([batch])
  @@index([accessMode])
  @@map("exams")
}

model ExamQuestion {
  id              String    @id @default(cuid())
  examId          String
  questionId      String
  order           Int       @default(0)
  marks           Decimal   @db.Decimal(8, 2) // this question's marks in this test
  // Pinned at publish (or first start): what every attempt in this test grades against.
  snapshot        Json?
  questionVersion Int?
  pinnedAt        DateTime?

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId])
  @@unique([examId, order])
  @@index([examId])
  @@map("exam_questions")
}

model ExamAssignment {
  id             String           @id @default(cuid())
  examId         String
  // Assignments are keyed by email so a student can be assigned (or have
  // access revoked) before their first sign-in; userId is linked at sign-in.
  email          String
  userId         String?
  assignedById   String?
  assignedAt     DateTime         @default(now())
  status         AssignmentStatus @default(ASSIGNED)
  // Accommodation set by an administrator (audited): copy/cut/paste are not
  // blocked or counted for this student in this exam. Nothing else changes.
  allowClipboard Boolean          @default(false)
  // Set by an administrator (audited): this student may not open or start this
  // test, whatever its access mode. Cleared to restore access.
  revokedAt      DateTime?

  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@unique([examId, email])
  @@index([userId])
  @@index([email])
  @@map("exam_assignments")
}

model Attempt {
  id                String               @id @default(cuid())
  userId            String
  examId            String
  sessionId         String // the sitting this work belongs to
  questionId        String
  html              String               @default("") @db.Text
  css               String               @default("") @db.Text
  js                String               @default("") @db.Text
  score             Decimal              @default(0) @db.Decimal(12, 4)
  maxScore          Decimal              @default(0) @db.Decimal(12, 4) // = ExamQuestion.marks
  status            AttemptStatus        @default(IN_PROGRESS)
  resultStatus      QuestionResultStatus @default(NOT_RUN)
  passedCount       Int                  @default(0)
  enabledCount      Int                  @default(0) // enabled test cases graded
  // Grading lease: a grader owns the attempt until this instant, so concurrent
  // gradings of one attempt (submit vs sweep vs admin regrade) cannot overlap.
  gradingLeaseUntil DateTime?
  gradingError      String? // admin-facing reason the last grading could not finish
  reviewFeedback    String?              @db.Text
  reviewedAt        DateTime?
  reviewedById      String?
  // Frozen copy of the question + its tests (incl. points) at attempt creation.
  snapshot          Json
  flags             Json?
  questionVersion   Int                  @default(1)
  startedAt         DateTime             @default(now())
  submittedAt       DateTime?
  gradedAt          DateTime?
  acceptedAt        DateTime?
  triesCount        Int                  @default(0)
  updatedAt         DateTime             @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  session  ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  testResults    TestResult[]
  testRuns       TestRun[]
  events         ProctorEvent[]
  scoreHistories AttemptScoreHistory[]
  attemptFlags   AttemptFlag[]

  @@unique([sessionId, questionId])
  @@index([examId, status])
  @@index([userId, examId])
  @@index([status, gradedAt])
  @@map("attempts")
}

model AttemptFlag {
  id        String          @id @default(cuid())
  attemptId String
  kind      AttemptFlagKind
  setById   String?
  note      String?         @db.Text
  createdAt DateTime        @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  setBy   User?   @relation("AdminAttemptFlags", fields: [setById], references: [id], onDelete: SetNull)

  @@unique([attemptId, kind])
  @@index([attemptId])
  @@index([kind])
  @@map("attempt_flags")
}

model TestResult {
  id            String   @id @default(cuid())
  attemptId     String
  testRunId     String?
  testId        String? // null when the question test row was later deleted
  testName      String
  passed        Boolean
  points        Decimal  @default(0) @db.Decimal(12, 4) // this test's equal share of the question marks
  pointsAwarded Decimal  @default(0) @db.Decimal(12, 4)
  message       String?  @db.Text // student-visible failure message (definition + result only)
  expected      String?  @db.Text // expected value of the failing check, when meaningful
  actual        String?  @db.Text // value found on the student's page
  durationMs    Int      @default(0)
  final         Boolean  @default(false) // true = counted towards the stored score
  createdAt     DateTime @default(now())

  attempt Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  test    QuestionTest? @relation(fields: [testId], references: [id], onDelete: SetNull)
  testRun TestRun?      @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([attemptId, final])
  @@index([testRunId])
  @@map("test_results")
}

model TestRun {
  id            String        @id @default(cuid())
  attemptId     String?
  questionId    String? // set for VALIDATION runs
  userId        String?
  kind          TestRunKind   @default(PRACTICE)
  status        TestRunStatus @default(QUEUED)
  passedCount   Int           @default(0)
  failedCount   Int           @default(0)
  totalCount    Int           @default(0)
  score         Decimal       @default(0) @db.Decimal(12, 4)
  maxScore      Decimal       @default(0) @db.Decimal(12, 4)
  triggeredById String? // admin who requested a regrade, if any
  reason        String? // why a graded run happened (submit, auto-submit, regrade: ...)
  durationMs    Int           @default(0)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  code          Json? // Snapshot of { html, css, js } at time of execution
  logs          String?       @db.Text // sanitised runner log
  error         String?       @db.Text // sanitised error summary

  attempt Attempt?     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@index([attemptId])
  @@index([status])
  @@index([startedAt])
  @@map("test_runs")
}

model ProctorEvent {
  id         String           @id @default(cuid())
  userId     String
  examId     String
  sessionId  String? // the sitting it happened in (violation limits are per sitting)
  attemptId  String?
  type       ProctorEventType
  occurredAt DateTime         @default(now())
  durationMs Int?
  violation  Boolean          @default(true) // informational events are false
  metadata   Json?
  createdAt  DateTime         @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  session ExamSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempt Attempt?     @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, examId])
  @@index([examId, occurredAt])
  @@index([attemptId])
  @@index([sessionId, violation])
  @@map("proctor_events")
}

model ExamSession {
  id             String         @id @default(cuid())
  userId         String
  examId         String
  attemptNumber  Int            @default(1) // 1-based, per student per test
  startedAt      DateTime       @default(now())
  lastHeartbeat  DateTime       @default(now())
  endedAt        DateTime?
  expiresAt      DateTime // server-authoritative deadline for this sitting
  status         SessionStatus  @default(ACTIVE)
  userAgent      String?
  violationCount Int            @default(0) // denormalised counter, DB is the source of truth
  // Totals, written by the grading engine once every attempt in the sitting is graded.
  score          Decimal?       @db.Decimal(12, 4)
  maxScore       Decimal        @default(0) @db.Decimal(12, 4)
  percentage     Decimal?       @db.Decimal(7, 4)
  result         SittingResult?
  gradedAt       DateTime?
  disqualifiedAt DateTime?
  disqualifiedById String?
  disqualifiedReason String? @db.Text

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempts Attempt[]
  events   ProctorEvent[]

  @@unique([userId, examId, attemptNumber])
  @@index([userId, examId])
  @@index([examId, status])
  @@index([lastHeartbeat])
  @@map("exam_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model AttemptScoreHistory {
  id               String                @id @default(cuid())
  attemptId        String
  questionId       String
  oldScore         Decimal               @db.Decimal(12, 4)
  newScore         Decimal               @db.Decimal(12, 4)
  oldResultStatus  QuestionResultStatus?
  newResultStatus  QuestionResultStatus?
  changedAt        DateTime              @default(now())
  changedByAdminId String?
  reason           String?               @db.Text

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@index([changedAt])
  @@map("attempt_score_histories")
}
